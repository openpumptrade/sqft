{
  "name": "pumpkit",
  "version": "0.1.0",
  "description": "Componentized Solana / pump.fun toolkit: claims, buys, sells, burns, transfers, holder snapshots, airdrops, launches, fee sharing — the pieces every launch engine reuses.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./context": "./src/context.js",
    "./tx": "./src/tx.js",
    "./wallet": "./src/wallet.js",
    "./token": "./src/token.js",
    "./transfer": "./src/transfer.js",
    "./burn": "./src/burn.js",
    "./jupiter": "./src/jupiter.js",
    "./swap": "./src/swap.js",
    "./holders": "./src/holders.js",
    "./airdrop": "./src/airdrop.js",
    "./engine": "./src/engine.js",
    "./pumpfun/curve": "./src/pumpfun/curve.js",
    "./pumpfun/pumpswap": "./src/pumpfun/pumpswap.js",
    "./pumpfun/fees": "./src/pumpfun/fees.js",
    "./pumpfun/create": "./src/pumpfun/create.js",
    "./pumpfun/market": "./src/pumpfun/market.js",
    "./pumpfun/verify": "./src/pumpfun/verify.js"
  },
  "bin": {
    "pumpkit": "bin/pumpkit.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@pump-fun/pump-sdk": "^4.3.1",
    "@pump-fun/pump-swap-sdk": "^1.20.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.1",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7"
  }
}
